# Code style for this project. Format all files with:
#   clang-format -i src/*.h src/*.cpp tests/*.h tests/*.cpp
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
AllowShortCaseLabelsOnASingleLine: true
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-z_]+>$'  # C++ standard library
    Priority: 1
  - Regex: '^<.+>$'       # third-party libraries (GoogleTest)
    Priority: 2
  - Regex: '.*'           # this project
    Priority: 3
